using System;
using System.Collections.Generic;

// 1. Battery Interface
interface IBattery
{
    int RemainingEnergy { get; }
    void Consume(int amount);
    void Recharge(int amount);
}

// 2. Lithium Battery
class LithiumBattery : IBattery
{
    private int _remainingEnergy;

    public LithiumBattery(int energy)
    {
        _remainingEnergy = energy;
        if (_remainingEnergy < 0)
            _remainingEnergy = 0;
        if (_remainingEnergy > 100)
            _remainingEnergy = 100;
    }

    public int RemainingEnergy
    {
        get { return _remainingEnergy; }
    }

    public void Consume(int amount)
    {
        if (amount < 0)
            return;

        _remainingEnergy -= amount;

        if (_remainingEnergy < 0)
            _remainingEnergy = 0;
    }

    public void Recharge(int amount)
    {
        if (amount < 0)
            return;

        _remainingEnergy += amount;

        if (_remainingEnergy > 100)
            _remainingEnergy = 100;
    }
}

